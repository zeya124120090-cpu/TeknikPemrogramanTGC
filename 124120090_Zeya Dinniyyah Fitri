#  Kelas induk
class Sensor:
    def __init__(self, id_sensor, lokasi, jenis):
        self.id_sensor = id_sensor
        self.lokasi = lokasi
        self.jenis = jenis
    def info(self):
        return f"Sensor ID: {self.id_sensor}, Lokasi: {self.lokasi}, Jenis: {self.jenis}"
# Kelas turunan
class SensorSeismik(Sensor):
    def __init__(self, id_sensor, lokasi, jenis, frekuensi_sampling):
        super().__init__(id_sensor, lokasi, jenis)
        self.frekuensi_sampling = frekuensi_sampling

    def jumlah_sampel(self, durasi_detik):
        """
        Hitung jumlah data amplitudo berdasarkan durasi (dalam detik).
        """
        return self.frekuensi_sampling * durasi_detik
# Contoh penggunaan
if __name__ == "__main__":
    sensor1 = Sensor("S001", "Jakarta", "Umum")
    print(sensor1.info())
    sensor_seismik = SensorSeismik("SS01", "Bandung", "Seismik", 100)  # 100 Hz
    print(sensor_seismik.info())
    print("Jumlah sampel dalam 10 detik:", sensor_seismik.jumlah_sampel(10))


