# from abc import ABC, abstractmethod
# Kelas abstrak
class Survey(ABC):
    def __init__(self, lokasi, metode):
        self.lokasi = lokasi
        self.metode = metode
    @abstractmethod
    def processing(self):
        pass
# Turunan 1: Seismic Survey
class SeismicSurvey(Survey):
    def __init__(self, lokasi):
        super().__init__(lokasi, "Seismik")
    def processing(self):
        print(f"[Seismic Survey] Lokasi: {self.lokasi} -> Processing: Filtering data seismik...")
# Turunan 2: Gravity Survey
class GravitySurvey(Survey):
    def __init__(self, lokasi):
        super().__init__(lokasi, "Gravitasi")
    def processing(self):
        print(f"[Gravity Survey] Lokasi: {self.lokasi} -> Processing: Upward continuation data gravitasi...")
# Turunan 3: Magnetic Survey
class MagnetikSurvey(Survey):
    def __init__(self, lokasi):
        super().__init__(lokasi, "Magnetik")
    def processing(self):
        print(f"[Magnetik Survey] Lokasi: {self.lokasi} -> Processing: Anomaly mapping data magnetik...")
# Contoh penggunaan
if __name__ == "__main__":
    # Membuat daftar objek survey
    surveys = [
        SeismicSurvey("Bandung"),
        GravitySurvey("Papua"),
        MagnetikSurvey("Kalimantan")
    ]
    # Iterasi untuk memanggil method processing()
    for s in surveys:
        s.processing()
